{
  "github": {
    "silent": true
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/ops/community-leaders",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/alerts/deliver?cron=v3",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/member-weekly-intelligence/deliver?cron=v1",
      "schedule": "0 14 * * 4"
    },
    {
      "path": "/api/member-weekly-intelligence/deliver?rescue=1&live=1&cron=retention-v1",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/gifts/deliver?live=1&cron=v1",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/account-deletion/cleanup",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/ops/pricing-health",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/ops/source-scheduler",
      "schedule": "*/5 * * * *"
    }
  ]
}
