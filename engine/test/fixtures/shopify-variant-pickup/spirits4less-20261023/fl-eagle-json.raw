{"product":{"id":8771180658929,"title":"EAGLE RARE 10 YEARS KENTUCKY STRAIGHT 750ML","body_html":"\u003cp data-start=\"0\" data-end=\"551\"\u003eThis well aged Kentucky straight bourbon is crafted to express elegance balance and depth developed through extended maturation. The aroma is refined and inviting with notes of caramel vanilla toasted oak and subtle hints of dried fruit that unfold smoothly. On the palate it delivers a well structured and polished profile featuring mellow sweetness gentle spice and a refined wood influence that integrates seamlessly. The finish is long smooth and warming, leaving a graceful impression that makes it ideal for sipping neat and appreciating slowly.\u003c\/p\u003e","vendor":"spirits-4-less","product_type":"","created_at":"2025-03-15T05:21:04-04:00","handle":"eagle-rare-10-years-kentucky-straight-750ml","updated_at":"2026-10-23T11:00:31-04:00","published_at":"2025-03-18T17:37:16-04:00","template_suffix":null,"published_scope":"global","tags":"","variants":[{"id":46003928727793,"product_id":8771180658929,"title":"Default Title","price":"44.97","sku":"88004021344","position":1,"compare_at_price":"79.97","fulfillment_service":"manual","inventory_management":"shopify","option1":"Default Title","option2":null,"option3":null,"created_at":"2025-03-15T05:21:04-04:00","updated_at":"2026-10-23T11:00:31-04:00","taxable":true,"barcode":null,"grams":3175,"image_id":null,"weight":7.0,"weight_unit":"lb","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"USD","compare_at_price_currency":"USD","quantity_price_breaks":[]}],"options":[{"id":11060738621681,"product_id":8771180658929,"name":"Title","position":1,"values":["Default Title"]}],"images":[{"id":43297183236337,"product_id":8771180658929,"position":1,"created_at":"2025-03-15T05:21:04-04:00","updated_at":"2026-02-06T10:58:02-05:00","alt":"EAGLE RARE 10 YEARS KENTUCKY STRAIGHT 750ML MIAMI LIQUOR WINE STORE","width":800,"height":800,"src":"https:\/\/c